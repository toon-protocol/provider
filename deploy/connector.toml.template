# =============================================================================
# Connector config for a TOON provider box — rendered by ./render.sh
# =============================================================================
# The connector is the payment proxy in front of `toon-provider`. It terminates
# payment, unseals the packet and forwards a plain HTTP POST to the app — so
# the app reads no X-TOON-* header and contains no ILP, claim or settlement
# logic. It also means the app's listener must never be reachable any other
# way: a spawn that arrives past the connector is a spawn nobody paid for.
#
# Three rules the parser enforces, worth knowing before you edit:
#
#   * One TOML file, read once at startup, immutable for the process
#     lifetime. There is NO environment-variable layer — the only variable the
#     connector reads is RUST_LOG. Editing this file does nothing until the
#     container restarts (a bind mount is not a reload).
#   * Unknown keys are a hard startup failure, and removed keys are refused by
#     name. A stale config says so at boot instead of quietly doing nothing,
#     but it means a config change and a connector upgrade must land in the
#     right order. Land config first.
#   * Every key that carries a secret is a PATH, never the value — so the
#     rendered connector.toml is not a secret. (provider.toml, beside it, IS:
#     it carries this provider's Nostr key inline.)
#
# deploy/README.md § "Bumping the connector pin" has the procedure. Nothing
# here names an operator: the address, the domain and the settlement values
# come from .env, and the [[routes]] are generated from provider.toml at
# render time, so the two files cannot disagree about a route, a price or a
# handler.
# =============================================================================

# The client edge: POST /ilp, GET /ilp/btp, GET /ilp/identity and /metrics all
# share this port. Bound to 0.0.0.0 INSIDE the container only — docker-compose
# publishes it on 127.0.0.1, and nginx is what faces the internet.
client_edge_addr = "0.0.0.0:4000"

# Where this node records which claims it has already been paid. This MUST be a
# mounted volume: a watermark that dies with the container hands every payer
# their spent claims back as free service.
state_dir = "/app/state"

# No peering is configured and none is expected: a tenant pays this node
# DIRECTLY at its own client edge, which is the shape the devnet already
# documents for the store and the gas station. `peer_expose` still names a
# carriage because `[node]` below declares endpoints and the two must agree.
peer_expose = "http"

# @hidden-only:begin
# ON A HIDDEN BOX ONLY: the anon daemon's SOCKS port, the one proxy this node
# has (connector ADR 0070). It carries the ILP wire to any `.anyone` peer, and
# every [settlement.*] table below that sets `rpc_via_socks_proxy = true`
# (connector ADR 0073) — each chain on a circuit of its own, pinned by SOCKS
# username. A table that asks for it with no proxy here is a refusal to start,
# and a proxy that is down fails the settlement dial; nothing falls back to a
# direct one. The same address provider.toml's `anon.socks_proxy` names.
# Root level, before any table, or TOML would read it as a table's key.
socks_proxy = "socks5h://172.30.2.2:9050"
# @hidden-only:end

# This node's signing identity. `GET /ilp/identity` answers with this key,
# every packet is sealed to it, and provider.toml's `connector_seal_key` is a
# verbatim copy of its public half — which is the value a tenant compares
# byte-for-byte before it will spawn anything here (ADR 0011).
[signer]
key_file = "/app/data/signer.key"


# ═════════════════════════════════════════════════════════════════════════════
# The terminated routes — GENERATED, NOT WRITTEN
# ═════════════════════════════════════════════════════════════════════════════
# Everything between here and the settlement tables is the exact output of
#
#     toon-provider routes --config provider.toml
#
# run by render.sh against the provider.toml it has just rendered, and spliced
# in place of the marker line below: one spawn and one extend row per LIVE
# listing version at that version's price, a standby pair at its
# `standby_price` for a tier that sells Warm Standbys, and the four free
# provider-wide rows. Every path is literal and the app serves exactly these.
#
# There is nothing to edit here. A listing change is a new version with new
# rows and a restart (ADR 0009): change the listings file and re-render. On a
# box the command runs inside the provider image and reads the live lease
# table, so a retired version keeps its rows while a lease still runs on it.
#
# The connector both TERMINATES and PRICES each route: a packet must arrive
# covered to the figure here or it is refused, and a refusal on a paid route
# is still billed (TOON_Network ADR 0003 — one route, one price, no refunds).
# The free rows are written `price = 0` rather than left out: a terminated
# route is never silently free, and the parser requires a price either way.
# @render: routes


# ── Getting paid ─────────────────────────────────────────────────────────────
# Settlement is per-chain, and every channel is an x402 `batch-settlement`
# channel (connector ADR 0075; its docs/releases/x402-only.md is the
# migration this table followed, provider#66). A tenant opens its own
# channel to this node on whichever chain it holds, deposits into it, and pays
# each packet with a voucher: a signed running total. The connector resolves a
# channel it has never seen from the chain and the voucher, so anyone can pay
# this node with no config edit here. The x402 contract (EVM) and the
# `payment-channels` program (Solana) are constants of the connector binary,
# never config: there is no `contract_address` or `program_id` to set.
#
# Fail-closed at STARTUP: the connector reads token_address's own decimals()
# and checks asset_transfer_method against the token. A wrong value is a
# refuse-to-start, not a silently mispriced node. The Solana leg also SUBMITS
# a transaction at boot (an idempotent associated token account create), and
# its key pays for every channel the sponsor endpoint opens, so that key must
# hold SOL before the first `up -d` — deploy/README.md § "The two funded
# identities".
#
# The values come from .env, the same ones provider.toml's [[settlement]]
# publishes. .env.example ships the TOON devnet's as a preset (Base Sepolia and
# Solana devnet mock USDC), and render.sh knows the x402 terms of those two
# tokens; read them back from any devnet node's `GET /ilp` (`batchSettlements`)
# rather than trusting a second copy of them.
#
# `rpc_via_socks_proxy` is how each table reaches its rpc_url (connector ADR
# 0073, TOON_Network ADR 0030), and render.sh decides it per chain:
#
#   public box    false: the preset's RPC, dialled directly.
#   hidden box    true, BY DEFAULT: the same public, keyless preset RPC, but
#                 only through the root `socks_proxy` above — every client of
#                 the table (the backend, its watchers, and on EVM the rate
#                 source) on that chain's pinned circuit, never direct. The
#                 connector refuses a plain http:// rpc_url here, because an
#                 exit relay could rewrite the answers.
#   hidden box,   false: HIDDEN_SETTLEMENT_<CHAIN>_RPC_URL, a node the
#   self-hosted   operator runs on a private address, in place of the
#                 preset's, dialled directly.
#
# provider.toml's [anon.settlement.*] carries the same two values, so the
# app's hiding gate judges exactly what is written here.

[settlement.evm]
rpc_url               = "${SETTLEMENT_EVM_RPC_URL}"
rpc_via_socks_proxy   = ${SETTLEMENT_EVM_RPC_VIA_SOCKS_PROXY}
token_address         = "${SETTLEMENT_EVM_TOKEN}"
decimals              = ${SETTLEMENT_EVM_DECIMALS}
# The token's EIP-712 domain: a tenant signs its deposit under it, and a wrong
# value is a signature that never verifies. Published as `name`/`version`.
asset_eip712_name     = "${SETTLEMENT_EVM_EIP712_NAME}"
asset_eip712_version  = "${SETTLEMENT_EVM_EIP712_VERSION}"
# How a deposit moves the token, published as `assetTransferMethod`: eip3009
# for a token with ERC-3009, permit2 for any other ERC-20.
asset_transfer_method = "${SETTLEMENT_EVM_ASSET_TRANSFER_METHOD}"
# The x402 facilitator this operator names for deposits into its channels
# (connector ADR 0076), published as `facilitator`, so a tenant holding no ETH
# can still open one. The connector never dials it. render.sh drops this line
# when .env sets SETTLEMENT_EVM_FACILITATOR_URL empty: the connector refuses ""
# as a URL.
facilitator_url       = "${SETTLEMENT_EVM_FACILITATOR_URL}"
# min_withdraw_delay_secs is left at the connector's default, one day: the
# shortest withdrawal delay a tenant's channel may carry and still be admitted.

[settlement.evm.key]
# Signs this chain's settlement transactions (landing a voucher), and is the
# address a tenant's channel names as its receiver.
key_file = "/app/data/settlement.key"

[settlement.solana]
rpc_url               = "${SETTLEMENT_SOLANA_RPC_URL}"
rpc_via_socks_proxy   = ${SETTLEMENT_SOLANA_RPC_VIA_SOCKS_PROXY}
token_address         = "${SETTLEMENT_SOLANA_TOKEN}"
decimals              = ${SETTLEMENT_SOLANA_DECIMALS}
# The smallest deposit, in the mint's base units, this node's sponsor endpoint
# opens a channel for. The endpoint is public and spends this node's SOL, so
# this is what bounds it.
min_sponsored_deposit = ${SETTLEMENT_SOLANA_MIN_SPONSORED_DEPOSIT}

[settlement.solana.key]
key_file = "/app/data/settlement-solana.key"


# ── The operator surface ─────────────────────────────────────────────────────
# Gates /metrics, the channel and claim reads and the channel writes (`land`,
# `withdraw`, `fund`). Without this section they are not mounted at all (404,
# not 401) — which also means no way to read or land what this provider has
# earned, so it is not optional in practice.
#
# Both are FILE-VALUED. The values live in two files render.sh writes from
# .env, 0600 and owned by uid 10001, mounted beside the key files — so the
# rendered connector.toml holds paths and nothing else. A section naming a
# file that is missing or empty is a refuse-to-start, never a silently open
# surface.
#
# `write_keys_file` is the allowlist of RFC 9421 signing keys for operator
# WRITES, one ED25519 PUBLIC key per line in 64 hex characters, `#` comments
# allowed. The private half never lives on this box; to sign a write from a
# shell, use the connector repository's docs/operators/sign-write.sh. Revoke a
# key by deleting its line and restarting.
[operator]
bearer_token_file = "/app/data/operator-bearer.token"
write_keys_file   = "/app/data/operator-write.keys"


# ═════════════════════════════════════════════════════════════════════════════
# THIS DEPLOYMENT
# ═════════════════════════════════════════════════════════════════════════════
# Everything above describes any provider behind any connector. What follows is
# this box's place on the network: the address it answers for (ILP_ADDRESS,
# the same one provider.toml's routes hang off) and the URLs it is reachable
# on. A tenant reads these back from `GET /ilp` to discover the node, and
# `auto-apply.sh` compares them against what the running process actually
# serves on every apply.
#
# render.sh writes the two endpoints: `https://` and `wss://` on
# proxy.provider.<DOMAIN> on a public box, and `http://` and `ws://` on the
# box's `.anyone` address on a hidden one (HIDDEN=1). A client dials what a
# node PUBLISHES, so on a hidden box the endpoint has to be the circuit; the
# plaintext schemes are what an `.anyone` host takes (connector ADR 0070),
# because the address is itself the key it is reached by.
[node]
addresses     = ["${ILP_ADDRESS}"]
http_endpoint = "${NODE_HTTP_ENDPOINT}"
btp_endpoint  = "${NODE_BTP_ENDPOINT}"
